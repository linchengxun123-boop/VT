# Supported modes: local (default) and supabase. Unset/other values use local.
# Local mode requires Node.js 24+ and persistent SQLite in ./data/vt.sqlite.
NEXT_PUBLIC_DATA_MODE=local
# To enable Supabase, replace the mode above with:
# NEXT_PUBLIC_DATA_MODE=supabase
# Fill the URL and Publishable Key below. Never use a secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only, used when Publishable Key is absent or empty:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional local database override
# VT_DB_PATH=./data/vt.sqlite
